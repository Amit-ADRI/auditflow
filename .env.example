PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://auditflow:auditflow_dev@localhost:5432/auditflow?schema=public
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
# Configure all three to enable Cloudinary. If any is missing, files are saved locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Change these before deployment. These values are used for the initial accounts.
MANAGER_EMAIL=manager@auditflow.in
MANAGER_PASSWORD=Audit@123
DOCTOR_EMAIL=doctor@auditflow.in
DOCTOR_PASSWORD=Audit@123
